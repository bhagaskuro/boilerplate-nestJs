import {
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { Prisma } from '@prisma/client';
import { PrismaService } from '../../common/prisma/prisma.service';
import { Create__SINGULAR_PASCAL__Dto } from './core/dto/create-__SINGULAR_KEBAB__.dto';
import { Update__SINGULAR_PASCAL__Dto } from './core/dto/update-__SINGULAR_KEBAB__.dto';
import { __SINGULAR_KEBAB__QueryDto } from './core/dto/__SINGULAR_KEBAB__-query.dto';
import { __SINGULAR_KEBAB__Transform } from './core/helpers/__SINGULAR_KEBAB__-transform.helper';

@Injectable()
export class __RESOURCE_PASCAL__Service {
  constructor(private readonly prisma: PrismaService) {}

  private get delegate() {
    // The generator assumes a Prisma model named __SINGULAR_PASCAL__ (delegate prisma.__PRISMA_MODEL__).
    return this.prisma.__PRISMA_MODEL__;
  }

  async create(dto: Create__SINGULAR_PASCAL__Dto) {
    const record = await this.delegate.create({
      data: dto as Prisma.__SINGULAR_PASCAL__CreateInput,
    });
    return __SINGULAR_KEBAB__Transform.toResponse(record);
  }

  async findAll(query: __SINGULAR_KEBAB__QueryDto) {
    const page = Math.max(1, Number(query.page) || 1);
    const limit = Math.min(100, Math.max(1, Number(query.limit) || 10));
    const skip = (page - 1) * limit;

    const [items, total] = await this.prisma.$transaction([
      this.delegate.findMany({ skip, take: limit, orderBy: { id: 'desc' } }),
      this.delegate.count(),
    ]);

    return {
      data: items.map((item) => __SINGULAR_KEBAB__Transform.toResponse(item)),
      meta: {
        total,
        page,
        limit,
        totalPages: Math.ceil(total / limit),
      },
    };
  }

  async findOne(id: number) {
    const record = await this.delegate.findUnique({ where: { id } });
    if (!record) throw new NotFoundException(`${'__SINGULAR_PASCAL__'} with id ${id} was not found`);
    return __SINGULAR_KEBAB__Transform.toResponse(record);
  }

  async update(id: number, dto: Update__SINGULAR_PASCAL__Dto) {
    await this.findOne(id);
    const record = await this.delegate.update({
      where: { id },
      data: dto as Prisma.__SINGULAR_PASCAL__UpdateInput,
    });
    return __SINGULAR_KEBAB__Transform.toResponse(record);
  }

  async remove(id: number) {
    await this.findOne(id);
    await this.delegate.delete({ where: { id } });
    return { message: `${'__SINGULAR_PASCAL__'} deleted successfully` };
  }
}
